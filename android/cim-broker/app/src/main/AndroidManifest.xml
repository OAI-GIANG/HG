<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">


    <queries>
        <package android:name="com.termux" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="HG CIM Broker"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="HG CIM Broker">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- One exported read-only Binder ContentProvider method. Every call authenticates
             Binder UID, exact package and owner-pinned signer. No generic command surface. -->
        <provider
            android:name=".CimBrokerProvider"
            android:authorities="org.hg.cim.broker.ipc"
            android:exported="true"
            android:grantUriPermissions="false" />

    </application>
</manifest>
