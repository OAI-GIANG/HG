{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OAI-GIANG/HG/blob/main/hg/schemas/runtime-service-config-v1.schema.json",
  "title": "HG Runtime Service Configuration V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "host", "port", "state_dir", "token_file", "release_root", "release_manifest", "release_id", "max_body_bytes"],
  "properties": {
    "schema": {"const": "hg-runtime-service-config-v1"},
    "host": {"const": "127.0.0.1"},
    "port": {"type": "integer", "minimum": 1, "maximum": 65535},
    "state_dir": {"type": "string", "minLength": 1, "pattern": "^/"},
    "token_file": {"type": "string", "minLength": 1, "pattern": "^/"},
    "release_root": {"type": "string", "minLength": 1, "pattern": "^/"},
    "release_manifest": {"type": "string", "minLength": 1, "pattern": "^/"},
    "release_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "max_body_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576}
  }
}
