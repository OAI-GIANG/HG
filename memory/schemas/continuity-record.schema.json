{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hg:memory:continuity-record-1.0.0.schema.json",
  "title": "HG MAEP Task Continuity Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_version", "task_id", "created_at", "updated_at", "linked_task_id",
    "objective", "scope", "current_state", "state_as_of", "candidate_ref",
    "policy_version", "task_version", "completed_steps", "pending_steps",
    "blockers", "decisions", "evidence_refs", "checkpoint", "next_action",
    "freshness", "integrity_and_recovery"
  ],
  "properties": {
    "record_version": {"const": "MAEP-AFCP-1.0.0"},
    "task_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "linked_task_id": {"type": ["string", "null"]},
    "objective": {"type": "string", "minLength": 1},
    "scope": {"type": "object", "required": ["include", "exclude"], "properties": {
      "include": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
      "exclude": {"type": "array", "items": {"type": "string"}}
    }},
    "current_state": {"enum": ["DRAFT", "READY", "ASSESSED", "PLANNED", "AUTHORIZED", "RUNNING", "VERIFYING", "ACCEPTED", "CLOSED_VERIFIED", "BLOCKED", "FAILED", "CANCELLED", "UNVERIFIED"]},
    "state_as_of": {"type": "string", "format": "date-time"},
    "candidate_ref": {"type": "string", "minLength": 1},
    "policy_version": {"type": "string", "minLength": 1},
    "task_version": {"type": "integer", "minimum": 1},
    "completed_steps": {"type": "array", "items": {
      "type": "object", "required": ["step_id", "outcome", "timestamp", "evidence_refs"],
      "properties": {
        "step_id": {"type": "string", "minLength": 1},
        "outcome": {"type": "string", "minLength": 1},
        "timestamp": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "items": {"type": "string"}},
        "verification_status": {"enum": ["VERIFIED", "UNVERIFIED"]}
      }
    }},
    "pending_steps": {"type": "array", "items": {
      "type": "object", "required": ["step_id", "prerequisites", "acceptance_conditions"],
      "properties": {
        "step_id": {"type": "string", "minLength": 1},
        "prerequisites": {"type": "array"},
        "acceptance_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }},
    "blockers": {"type": "array", "items": {"type": "object"}},
    "decisions": {"type": "array", "items": {"type": "object"}},
    "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "checkpoint": {"type": "object", "required": ["checkpoint_id", "schema_version", "task_id", "candidate_ref", "policy_version", "captured_at", "event_sequence", "content_digest"],
      "properties": {
        "checkpoint_id": {"type": "string", "minLength": 1},
        "schema_version": {"const": "MAEP-AFCP-1.0.0"},
        "task_id": {"type": "string", "minLength": 1},
        "candidate_ref": {"type": "string", "minLength": 1},
        "policy_version": {"type": "string", "minLength": 1},
        "captured_at": {"type": "string", "format": "date-time"},
        "event_sequence": {"type": "integer", "minimum": 0},
        "content_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }},
    "next_action": {"type": "object", "required": ["description", "preconditions", "required_authorization", "expected_result", "stop_condition"],
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "preconditions": {"type": "array"},
        "required_authorization": {},
        "expected_result": {"type": "string", "minLength": 1},
        "stop_condition": {"type": "string", "minLength": 1}
      }},
    "freshness": {"type": "object", "required": ["last_live_state_inspection_at", "inspected_resources", "stale_unknown_reasons"],
      "properties": {
        "last_live_state_inspection_at": {"type": "string", "minLength": 1},
        "inspected_resources": {"type": "array", "items": {"type": "object", "required": ["resource_id", "version"], "properties": {
          "resource_id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}
        }}},
        "stale_unknown_reasons": {"type": "array", "items": {"type": "string"}}
      }},
    "integrity_and_recovery": {"type": "object", "required": ["last_successfully_loaded_event_sequence", "parse_validation_result", "detected_gaps_or_corruption"],
      "properties": {
        "last_successfully_loaded_event_sequence": {"type": "integer", "minimum": 0},
        "parse_validation_result": {"enum": ["PASS", "FAIL", "UNKNOWN"]},
        "detected_gaps_or_corruption": {"type": "array"}
      }}
  }
}
