{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hg-runtime-policy-v2.schema.json",
  "title": "HG Runtime Policy V2 source envelope",
  "description": "Strict policy source envelope. Digest and owner approval are verified by runtime code; this schema does not itself establish authorization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy",
    "policy_digest"
  ],
  "properties": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "status",
        "version",
        "root_generation",
        "approval_evidence_refs",
        "grant_ttl_seconds",
        "rules"
      ],
      "properties": {
        "schema_version": {
          "const": "hg.policy.v2"
        },
        "status": {
          "const": "ACTIVE"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "root_generation": {
          "type": "integer",
          "minimum": 1
        },
        "approval_evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "grant_ttl_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "resource",
              "match_mode",
              "effect",
              "scope"
            ],
            "properties": {
              "action": {
                "type": "string",
                "minLength": 1
              },
              "resource": {
                "type": "string",
                "minLength": 1
              },
              "match_mode": {
                "enum": [
                  "EXACT",
                  "TEMPLATE"
                ]
              },
              "effect": {
                "enum": [
                  "ALLOW",
                  "DENY"
                ]
              },
              "scope": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "applicability_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rule_id",
              "actions",
              "resource_prefix",
              "classification"
            ],
            "properties": {
              "rule_id": {
                "type": "string",
                "minLength": 1
              },
              "actions": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "resource_prefix": {
                "type": "string",
                "pattern": "^memory:"
              },
              "classification": {
                "const": "NOT_REQUIRED"
              }
            }
          }
        }
      }
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
