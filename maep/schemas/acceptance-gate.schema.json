{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hg:maep:acceptance-gate-1.0.0.schema.json",
  "title": "MAEP Acceptance Gate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "gate_id",
    "task_id",
    "candidate_ref",
    "required",
    "status",
    "criteria_refs",
    "evidence_refs"
  ],
  "properties": {
    "gate_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_ref": {
      "type": "string",
      "minLength": 1
    },
    "required": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "NOT_RUN",
        "PASS",
        "FAIL",
        "BLOCKED",
        "NOT_APPLICABLE"
      ]
    },
    "criteria_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "not_applicable_reason": {
      "type": "string"
    }
  }
}
