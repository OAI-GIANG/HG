{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hg:maep:evidence-1.0.0.schema.json",
  "title": "MAEP Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id",
    "evidence_type",
    "source_ref",
    "candidate_ref",
    "collected_at",
    "collector",
    "method",
    "result",
    "limitations"
  ],
  "properties": {
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_type": {
      "enum": [
        "OBSERVATION",
        "COMMAND_OUTPUT",
        "TEST_RESULT",
        "REVIEW",
        "ARTIFACT",
        "EXTERNAL_SOURCE",
        "OTHER"
      ]
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    },
    "candidate_ref": {
      "type": "string",
      "minLength": 1
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "collector": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "result": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "integrity_metadata": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      }
    },
    "test_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
