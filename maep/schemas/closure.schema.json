{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hg:maep:closure-1.0.0.schema.json",
  "title": "MAEP Closure",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "closure_id",
    "task_id",
    "final_state",
    "candidate_ref",
    "policy_version",
    "criteria_results",
    "gate_refs",
    "evidence_refs",
    "limitations",
    "closed_at"
  ],
  "properties": {
    "closure_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "final_state": {
      "enum": [
        "CLOSED_VERIFIED",
        "FAILED",
        "CANCELLED",
        "BLOCKED",
        "UNVERIFIED"
      ]
    },
    "candidate_ref": {
      "type": "string",
      "minLength": 1
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "criteria_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion_id",
          "status",
          "evidence_refs"
        ],
        "properties": {
          "criterion_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED",
              "NOT_RUN",
              "NOT_APPLICABLE"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "gate_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "closed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
