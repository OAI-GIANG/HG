{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hg-native-authority-v1.schema.json",
  "title": "HG Native Authority V1 contracts",
  "description": "Offline-first authority contracts. Schema validity alone does not prove provenance or authorization.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "root_id", "generation", "status", "created_at", "bootstrap_authorization_ref", "verification_method", "verification_material_ref", "previous_root_digest", "policy_change_rule_ref", "record_digest", "evidence_ref"],
  "properties": {
    "schema_version": {"const": "hg.trust-root.v1"},
    "root_id": {"type": "string", "minLength": 1},
    "generation": {"type": "integer", "minimum": 1},
    "status": {"const": "ACTIVE"},
    "created_at": {"type": "string", "format": "date-time"},
    "bootstrap_authorization_ref": {"type": "string", "minLength": 1},
    "verification_method": {"type": "string", "minLength": 1},
    "verification_material_ref": {"type": "string", "minLength": 1},
    "previous_root_digest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "policy_change_rule_ref": {"type": "string", "minLength": 1},
    "record_digest": {"$ref": "#/$defs/digest"},
    "evidence_ref": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "trustRoot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "root_id", "generation", "status", "created_at", "bootstrap_authorization_ref", "verification_method", "verification_material_ref", "previous_root_digest", "policy_change_rule_ref", "record_digest", "evidence_ref"],
      "properties": {
        "schema_version": {"const": "hg.trust-root.v1"},
        "root_id": {"type": "string", "minLength": 1},
        "generation": {"type": "integer", "minimum": 1},
        "status": {"const": "ACTIVE"},
        "created_at": {"type": "string", "format": "date-time"},
        "bootstrap_authorization_ref": {"type": "string", "minLength": 1},
        "verification_method": {"type": "string", "minLength": 1},
        "verification_material_ref": {"type": "string", "minLength": 1},
        "previous_root_digest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "policy_change_rule_ref": {"type": "string", "minLength": 1},
        "record_digest": {"$ref": "#/$defs/digest"},
        "evidence_ref": {"type": "string", "minLength": 1}
      }
    },
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "principal_id", "status", "verified", "identity_evidence_ref", "capabilities", "resource_scopes", "allowed_scopes"],
      "properties": {
        "schema_version": {"const": "hg.principal.v1"},
        "principal_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["ACTIVE", "DISABLED", "REVOKED"]},
        "verified": {"const": true},
        "identity_evidence_ref": {"type": "string", "minLength": 1},
        "capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "resource_scopes": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "allowed_scopes": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "revoked": {"type": "boolean"},
        "not_before": {"type": ["string", "null"], "format": "date-time"},
        "expires_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "status", "version", "root_generation", "provenance_verified", "policy_digest", "approval_evidence_refs", "grant_ttl_seconds", "rules"],
      "properties": {
        "schema_version": {"const": "hg.policy.v1"},
        "status": {"const": "ACTIVE"},
        "version": {"type": "string", "minLength": 1},
        "root_generation": {"type": "integer", "minimum": 1},
        "provenance_verified": {"const": true},
        "policy_digest": {"$ref": "#/$defs/digest"},
        "approval_evidence_refs": {"$ref": "#/$defs/evidenceRefs"},
        "grant_ttl_seconds": {"type": "integer", "minimum": 1, "maximum": 300},
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["action", "resource", "effect", "scope"],
            "properties": {
              "action": {"type": "string", "minLength": 1},
              "resource": {"type": "string", "minLength": 1},
              "effect": {"enum": ["ALLOW", "DENY"]},
              "scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
            }
          }
        }
      }
    },
    "candidateIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified", "repository", "source_manifest_digest", "candidate_ref"],
      "properties": {
        "verified": {"const": true},
        "repository": {"const": "OAI-GIANG/HG"},
        "source_manifest_digest": {"$ref": "#/$defs/digest"},
        "candidate_ref": {"type": "string", "minLength": 1},
        "commit": {"type": ["string", "null"]},
        "dirty": {"type": "boolean"}
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified", "classification", "candidate_ref", "action", "resource", "applicability_id", "rule_version", "facts_used", "evidence_refs"],
      "properties": {
        "verified": {"const": true},
        "classification": {"enum": ["REQUIRED", "NOT_REQUIRED", "UNKNOWN"]},
        "candidate_ref": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "resource": {"type": "string", "minLength": 1},
        "applicability_id": {"type": "string", "minLength": 1},
        "rule_version": {"type": "string", "minLength": 1},
        "facts_used": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "evidence_refs": {"$ref": "#/$defs/evidenceRefs"}
      }
    },
    "gateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "verified", "evidence_verified", "evidence_refs", "candidate_ref", "policy_version", "gate_id"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"]},
        "verified": {"const": true},
        "evidence_verified": {"const": true},
        "evidence_refs": {"$ref": "#/$defs/evidenceRefs"},
        "candidate_ref": {"type": "string", "minLength": 1},
        "policy_version": {"type": "string", "minLength": 1},
        "gate_id": {"type": "string", "minLength": 1}
      }
    },
    "authorizationDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "reason_codes", "principal_ref", "action", "resource", "task_ref", "candidate_ref", "root_generation", "root_digest", "policy_version", "policy_digest", "applicability_ref", "applicability_classification", "gate_ref", "issued_at", "request_digest", "decision_digest"],
      "properties": {
        "decision": {"enum": ["ALLOW", "DENY", "BLOCKED"]},
        "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "principal_ref": {"type": ["string", "null"]},
        "action": {"type": ["string", "null"]},
        "resource": {"type": ["string", "null"]},
        "task_ref": {"type": ["string", "null"]},
        "candidate_ref": {"type": ["string", "null"]},
        "root_generation": {"type": ["integer", "null"], "minimum": 1},
        "root_digest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "policy_version": {"type": ["string", "null"]},
        "policy_digest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "applicability_ref": {"type": ["string", "null"]},
        "applicability_classification": {"type": ["string", "null"], "enum": ["REQUIRED", "NOT_REQUIRED", "UNKNOWN", null]},
        "gate_ref": {"type": ["string", "null"]},
        "issued_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": ["string", "null"], "format": "date-time"},
        "request_digest": {"$ref": "#/$defs/digest"},
        "decision_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "effectReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_id", "idempotency_key", "request_digest", "decision_digest", "candidate_ref", "policy_version", "root_generation", "adapter", "started_at", "completed_at", "outcome"],
      "properties": {
        "receipt_id": {"type": "string", "minLength": 1},
        "idempotency_key": {"type": "string", "minLength": 1},
        "request_digest": {"$ref": "#/$defs/digest"},
        "decision_digest": {"$ref": "#/$defs/digest"},
        "candidate_ref": {"type": "string", "minLength": 1},
        "policy_version": {"type": "string", "minLength": 1},
        "root_generation": {"type": "integer", "minimum": 1},
        "adapter": {"type": "string", "minLength": 1},
        "started_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"},
        "outcome": {"enum": ["SUCCESS", "FAILURE", "UNKNOWN", "BLOCKED", "DENY"]},
        "adapter_receipt": {"type": ["object", "null"]}
      }
    }
  }
}
