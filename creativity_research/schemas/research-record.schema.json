{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hg:creativity-research:research-record-1.0.0.schema.json",
  "title": "HG Creativity & Research Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "research_id", "task_ref", "question", "research_scope", "policy_version", "sources", "claims", "disagreements", "limitations", "status", "authority_effect"],
  "properties": {
    "contract_version": {"const": "hg.creativity-research.v1"},
    "research_id": {"type": "string", "minLength": 1},
    "task_ref": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "research_scope": {"type": "string", "minLength": 1},
    "policy_version": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false,
        "required": ["source_id", "ref", "source_type", "collection_method", "limitations"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "ref": {"type": "string", "minLength": 1},
          "source_type": {"type": "string", "minLength": 1},
          "collection_method": {"type": "string", "minLength": 1},
          "limitations": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "claims": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false,
        "required": ["claim_id", "claim_type", "statement", "source_refs", "evidence_refs", "limitations"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "claim_type": {"enum": ["FACT", "INFERENCE", "HYPOTHESIS", "PROPOSAL"]},
          "statement": {"type": "string", "minLength": 1},
          "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "limitations": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "disagreements": {"type": "array", "items": {"type": "object"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "status": {"const": "PREPARED_UNVERIFIED"},
    "authority_effect": {"const": "NONE"}
  }
}
