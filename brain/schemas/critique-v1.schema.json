{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hg:brain:critique-v1.schema.json",
  "title": "HG Critique Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version","task_ref","candidate_ref","policy_version","reviewed_plan_digest","verdict","reviewed_items","supported_claims","unsupported_claims","contradictions","counterarguments","missing_evidence","uncertainty","revision_requests","severity","stop_reason","status","epistemic_label","authority_effect","side_effects_performed","elapsed_ms","provider_timeout_seconds","output_bytes","revision_count"],
  "properties": {
    "contract_version": {"const":"hg.critique.v1"},
    "task_ref": {"type":"string","minLength":1},
    "candidate_ref": {"type":"string","minLength":1},
    "policy_version": {"type":"string","minLength":1},
    "reviewed_plan_digest": {"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "verdict": {"enum":["ACCEPT","REVISE","REJECT","INSUFFICIENT_EVIDENCE"]},
    "reviewed_items": {"type":"array","minItems":1,"maxItems":80,"items":{"$ref":"#/$defs/reviewedItem"}},
    "supported_claims": {"type":"array","maxItems":32,"items":{"$ref":"#/$defs/claimFinding"}},
    "unsupported_claims": {"type":"array","maxItems":32,"items":{"$ref":"#/$defs/unsupportedClaim"}},
    "contradictions": {"type":"array","maxItems":32,"items":{"$ref":"#/$defs/contradiction"}},
    "counterarguments": {"type":"array","maxItems":32,"items":{"$ref":"#/$defs/counterargument"}},
    "missing_evidence": {"type":"array","maxItems":32,"items":{"$ref":"#/$defs/missingEvidence"}},
    "uncertainty": {"type":"array","maxItems":32,"items":{"$ref":"#/$defs/uncertainty"}},
    "revision_requests": {"type":"array","maxItems":16,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":1000}},
    "severity": {"enum":["LOW","MEDIUM","HIGH","CRITICAL"]},
    "stop_reason": {"type":"string","maxLength":1000},
    "status": {"const":"CRITIQUE_RECORDED_UNVERIFIED"},
    "epistemic_label": {"const":"MODEL_CRITIQUE_NOT_FACT_VERIFICATION"},
    "authority_effect": {"const":"NONE"},
    "side_effects_performed": {"const":false},
    "elapsed_ms": {"type":"number","minimum":0},
    "provider_timeout_seconds": {"type":"number","exclusiveMinimum":0,"maximum":30},
    "output_bytes": {"type":"integer","minimum":1,"maximum":180000},
    "revision_count": {"const":0}
  },
  "$defs": {
    "refs": {"type":"array","maxItems":64,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":256}},
    "reviewedItem": {"type":"object","additionalProperties":false,"required":["item_id","assessment","rationale","evidence_refs"],"properties":{"item_id":{"type":"string","minLength":1,"maxLength":256},"assessment":{"enum":["NO_BLOCKER","BLOCKER","UNRESOLVED"]},"rationale":{"type":"string","minLength":1,"maxLength":2000},"evidence_refs":{"$ref":"#/$defs/refs"}}},
    "claimFinding": {"type":"object","additionalProperties":false,"required":["claim_id","rationale","evidence_refs"],"properties":{"claim_id":{"type":"string","minLength":1,"maxLength":256},"rationale":{"type":"string","minLength":1,"maxLength":2000},"evidence_refs":{"$ref":"#/$defs/refs"}}},
    "unsupportedClaim": {"type":"object","additionalProperties":false,"required":["claim_id","rationale","evidence_refs","missing_evidence"],"properties":{"claim_id":{"type":"string","minLength":1,"maxLength":256},"rationale":{"type":"string","minLength":1,"maxLength":2000},"evidence_refs":{"$ref":"#/$defs/refs"},"missing_evidence":{"type":"array","maxItems":16,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":1000}}}},
    "contradiction": {"type":"object","additionalProperties":false,"required":["description","claim_ids","evidence_refs"],"properties":{"description":{"type":"string","minLength":1,"maxLength":2000},"claim_ids":{"type":"array","minItems":2,"maxItems":16,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":256}},"evidence_refs":{"$ref":"#/$defs/refs"}}},
    "counterargument": {"type":"object","additionalProperties":false,"required":["argument","basis","evidence_refs"],"properties":{"argument":{"type":"string","minLength":1,"maxLength":2000},"basis":{"enum":["SOURCE_SUPPORTED","HYPOTHESIS"]},"evidence_refs":{"$ref":"#/$defs/refs"}}},
    "missingEvidence": {"type":"object","additionalProperties":false,"required":["requirement","reason"],"properties":{"requirement":{"type":"string","minLength":1,"maxLength":1000},"reason":{"type":"string","minLength":1,"maxLength":2000}}},
    "uncertainty": {"type":"object","additionalProperties":false,"required":["item","reason"],"properties":{"item":{"type":"string","minLength":1,"maxLength":1000},"reason":{"type":"string","minLength":1,"maxLength":2000}}}
  }
}
