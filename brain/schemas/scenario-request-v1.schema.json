{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hg:brain:scenario-request-v1.schema.json",
  "title": "HG Scenario Simulation Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version","scenario_id","task_ref","candidate_ref","policy_version","state_variables","transition_rules","scenarios","horizon_steps","assumptions"],
  "properties": {
    "contract_version": {"const":"hg.scenario.v1"},
    "scenario_id": {"type":"string","minLength":1,"maxLength":256},
    "task_ref": {"type":"string","minLength":1,"maxLength":256},
    "candidate_ref": {"type":"string","minLength":1,"maxLength":256},
    "policy_version": {"type":"string","minLength":1,"maxLength":256},
    "horizon_steps": {"type":"integer","minimum":1,"maximum":20},
    "assumptions": {"type":"array","maxItems":64,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":1000}},
    "state_variables": {"type":"array","minItems":1,"maxItems":16,"items":{"type":"object","additionalProperties":false,"required":["name","value","unit","min_value","max_value"],"properties":{"name":{"type":"string","minLength":1,"maxLength":128},"value":{"type":"number"},"unit":{"type":"string","minLength":1,"maxLength":64},"min_value":{"type":"number"},"max_value":{"type":"number"}}}},
    "transition_rules": {"type":"array","maxItems":32,"items":{"type":"object","additionalProperties":false,"required":["rule_id","variable","operation","value","value_unit"],"properties":{"rule_id":{"type":"string","minLength":1,"maxLength":128},"variable":{"type":"string","minLength":1,"maxLength":128},"operation":{"enum":["SET","ADD","MULTIPLY","MIN","MAX"]},"value":{"type":"number"},"value_unit":{"type":"string","minLength":1,"maxLength":64}}}},
    "scenarios": {"type":"array","minItems":1,"maxItems":20,"items":{"type":"object","additionalProperties":false,"required":["scenario_id","overrides","assumptions"],"properties":{"scenario_id":{"type":"string","minLength":1,"maxLength":256},"overrides":{"type":"array","maxItems":16,"items":{"type":"object","additionalProperties":false,"required":["variable","value"],"properties":{"variable":{"type":"string","minLength":1,"maxLength":128},"value":{"type":"number"}}}},"assumptions":{"type":"array","maxItems":64,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":1000}}}}}
  }
}
