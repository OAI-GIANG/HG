#!/data/data/com.termux/files/usr/bin/sh
# hg-runtime ./run — generated by switch_service.sh from deploy/termux/hg-runtime.run.in
# (@ROOT@ = verified release directory, @CONF@ = that release's service config).
exec 2>&1
set -eu
umask 077
termux-wake-lock 2>/dev/null || true
export HG_CANONICAL_REPOSITORY="OAI-GIANG/HG"
state_dir="${HG_FINISH_STATE_DIR:-$HOME/.local/state/hg}"
mkdir -p "$state_dir"
boot="$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || echo unknown)"

# After a failed short run (counted by ./finish), wait before starting again until GitHub
# answers with quota left. GET /rate_limit does not count against the quota, so a phone that
# booted before its network came up, or a quota that ran out, costs no further calls.
# At most 15 minutes; `sv down` ends the wait at once (TERM to this shell).
count=0
if [ -f "$state_dir/hg-runtime-finish.count" ]; then
  read -r cboot count _last < "$state_dir/hg-runtime-finish.count" || true
  [ "${cboot:-}" = "$boot" ] || count=0
  case "$count" in ''|*[!0-9]*) count=0 ;; esac
fi
if [ "$count" -gt 0 ]; then
  waited=0
  while [ "$waited" -lt 900 ]; do
    remaining="$(curl -sS -m 10 https://api.github.com/rate_limit 2>/dev/null \
      | python3 -I -c 'import json,sys; print(json.load(sys.stdin)["resources"]["core"]["remaining"])' 2>/dev/null \
      || echo -1)"
    case "$remaining" in ''|*[!0-9-]*) remaining=-1 ;; esac
    if [ "$remaining" -ge 4 ]; then break; fi
    echo "HG_RUNTIME_WAIT attempt=$count github_remaining=$remaining waited_s=$waited"
    sleep 30
    waited=$((waited + 30))
  done
fi

printf '%s %s\n' "$boot" "$(date +%s)" > "$state_dir/hg-runtime.started.tmp"
mv "$state_dir/hg-runtime.started.tmp" "$state_dir/hg-runtime.started"
cd "@ROOT@" || { echo 'HG_BLOCKED: verified release directory missing'; exit 78; }
exec python3 -B -u -m hg serve --config "@CONF@"
